<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>Aml.Editor.Plugin.AmlMcp</AssemblyName>
    <RootNamespace>Aml.Editor.Plugin.AmlMcp</RootNamespace>
    <Description>Makes the AutomationML document in the editor readable for AI assistants: ships the aml-mcp server, registers it with the assistant, and lets the assistant select elements in the editor.</Description>
    <PackageTags>AMLEditor; AMLEditorPlugin.Net; AutomationML; CAEX; MCP; LLM</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hsu-aut/AMLMcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hsu-aut/AMLMcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>

    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\build\Plugins\$(MSBuildProjectName)</BaseOutputPath>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aml.Editor.Plugin.Contract" Version="4.3.0">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <!-- The editor brings these at run time; keeping them out of the package means
         installing the plugin downloads nothing else. -->
    <PackageReference Include="Aml.Editor.API" Version="2.3.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Aml.Engine" Version="4.5.2">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Metadata.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="$(OutputPath)$(AssemblyName).deps.json" Pack="true" PackagePath="lib\$(TargetFramework)" />
  </ItemGroup>

  <!--
    The server is a .NET 10 program for three platforms, the plugin a .NET 8 WPF panel for
    Windows, so they cannot be one project. Building the plugin publishes the server into
    runtime\ when it is missing or older than its sources, so one build is enough.
  -->
  <PropertyGroup>
    <ServerProject>$(MSBuildThisFileDirectory)..\..\src\AmlMcp</ServerProject>
    <ServerExe>$(MSBuildThisFileDirectory)runtime\aml-mcp.exe</ServerExe>
    <ServerBuildDirectory>$(MSBuildThisFileDirectory)..\..\build\server-for-plugin\</ServerBuildDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ServerSource Include="$(ServerProject)\**\*.cs" Exclude="$(ServerProject)\bin\**;$(ServerProject)\obj\**" />
    <ServerSource Include="$(ServerProject)\*.csproj;$(ServerProject)\.mcp\server.json" />
    <!-- The version lives here, and a bump alone has to republish the server. -->
    <ServerSource Include="$(MSBuildThisFileDirectory)..\..\Directory.Build.props;$(MSBuildThisFileDirectory)..\..\global.json" />
  </ItemGroup>

  <Target Name="PublishServerIntoPlugin" Inputs="@(ServerSource)" Outputs="$(ServerExe)">
    <Message Importance="high" Text="Publishing aml-mcp into the plugin ..." />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; publish &quot;$(ServerProject)&quot; -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:EnableCompressionInSingleFile=true -p:DebugType=none -p:BaseOutputPath=&quot;$(ServerBuildDirectory)bin/&quot; -o &quot;$(MSBuildThisFileDirectory)runtime&quot; --nologo" />
  </Target>

  <!--
    The item has to be created after the publish. A static item with a Condition would be
    evaluated before any target runs, so on a fresh checkout the server would be missing
    from the output and, worse, from the package.
  -->
  <Target Name="AddServerToPlugin" DependsOnTargets="PublishServerIntoPlugin"
          BeforeTargets="AssignTargetPaths;_GetPackageFiles;GenerateNuspec">
    <Error Condition="!Exists('$(ServerExe)')"
           Text="aml-mcp.exe is missing at $(ServerExe). The plugin must not be packed without the server." />
    <ItemGroup>
      <None Include="$(ServerExe)" Link="runtime\aml-mcp.exe" CopyToOutputDirectory="PreserveNewest"
            Pack="true" PackagePath="lib\$(TargetFramework)\runtime\aml-mcp.exe" />
    </ItemGroup>
  </Target>

</Project>
