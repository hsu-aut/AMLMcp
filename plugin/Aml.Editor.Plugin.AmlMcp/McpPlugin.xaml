<wpf:PluginViewBase x:Class="Aml.Editor.Plugin.AmlMcp.McpPlugin"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:Aml.Editor.Plugin.WPFBase;assembly=Aml.Editor.Plugin.Contract">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12">

      <TextBlock Text="Ask an assistant about this document" FontSize="16" FontWeight="SemiBold" />
      <TextBlock TextWrapping="Wrap" Margin="0,6,0,12" Foreground="#555"
                 Text="The aml-mcp server gives an AI assistant read access to AutomationML files: hierarchies, class libraries, links, mirror objects and references. It runs on this machine and only reads." />

      <TextBlock Text="Server" FontWeight="SemiBold" />
      <TextBlock x:Name="ServerLine" TextWrapping="Wrap" Margin="0,2,0,10" />

      <TextBlock Text="Readable directory" FontWeight="SemiBold" />
      <TextBlock TextWrapping="Wrap" Margin="0,2,0,2" Foreground="#555"
                 Text="The assistant may read this directory and everything below it, nothing else." />
      <TextBox x:Name="RootBox" Margin="0,0,0,12" />

      <WrapPanel>
        <Button x:Name="TestButton" Content="Test with the open document" Padding="10,4" Margin="0,0,8,8" Click="OnTest" />
        <Button x:Name="ClaudeButton" Content="Register with Claude Desktop" Padding="10,4" Margin="0,0,8,8" Click="OnRegisterClaudeDesktop" />
        <Button x:Name="CopyButton" Content="Copy configuration" Padding="10,4" Margin="0,0,8,8" Click="OnCopyConfiguration" />
      </WrapPanel>

      <TextBox x:Name="Output" Margin="0,8,0,0" MinHeight="180" IsReadOnly="True"
               FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               Background="#F7F7F7" />

    </StackPanel>
  </ScrollViewer>
</wpf:PluginViewBase>
